{
  "name": "ai-ai-web",
  "private": false,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "ai爱 —— AI 情感陪伴 Web 应用：人格与情感内容原创，代码从零实现（AI 辅助）；纯前端 SPA，用户自备 OpenAI 兼容 LLM API",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean:dist && vite build --emptyOutDir=false",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "clean:dist": "node scripts/clean-dist.mjs",
    "postbuild": "node scripts/clean-dist.mjs --release",
    "postverify": "node scripts/clean-dist.mjs --release",
    "verify": "npm run clean:dist && npm run gen:assets && tsc --noEmit && npm run lint:copyTables && vite build --emptyOutDir=false",
    "lint:copy": "tsx scripts/check-copy.ts",
    "lint:copyTables": "tsx scripts/check-copy-tables.ts",
    "gen:assets": "node scripts/gen-assets.mjs",
    "predev": "npm run gen:assets",
    "prebuild": "npm run gen:assets",
    "apk": "node scripts/build-apk.mjs",
    "apk:list": "node scripts/build-apk.mjs --list",
    "apk:verify": "node scripts/build-apk.mjs --verify",
    "apk:legacy": "node scripts/archive-legacy.mjs",
    "apk:renumber": "node scripts/renumber-releases.mjs",
    "apk:check-apk": "python scripts/qa/check-apk-boot-fix.py",
    "qa:boot": "node scripts/qa/check-boot-compat.mjs && node scripts/qa/diagnose-blank.mjs --dir=dist --native && node scripts/qa/diagnose-blank.mjs --dir=dist --native --legacy && node scripts/qa/diagnose-blank.mjs --dir=dist --native --stale",
    "qa:boot:break": "node scripts/qa/diagnose-blank.mjs --dir=dist --break",
    "qa:url": "tsx scripts/qa/check-url-join.mjs",
    "qa:baseurl-ui": "node scripts/qa/check-baseurl-ui.mjs",
    "qa:settings-ui": "node scripts/qa/shot-settings.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@clarashafiq/jiwen": "^0.4.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@tanstack/react-virtual": "^3.10.8",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "react-zoom-pan-pinch": "^3.6.1",
    "remark-gfm": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^20.16.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
