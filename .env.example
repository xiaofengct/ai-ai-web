# —— ai爱 Web ai爱 · 环境变量示例 ——
# 说明：本应用为纯前端 SPA，**所有数据都在浏览器本地**（IndexedDB + localStorage）。
# 这个文件里**不允许出现任何真实密钥**；API Key 请在应用内的「设置 → 模型」中填写。

# 默认模型商 BaseURL（留空则使用 constants/providers.ts 中的预设）
VITE_DEFAULT_BASEURL=

# 默认模型名（留空则使用 Provider 预设）
VITE_DEFAULT_MODEL=

# 应用显示版本号（用于「更新说明」弹窗的版本比对；对应 CHANGELOG.md）
VITE_APP_VERSION=0.1.0

# 是否注册 Service Worker（false 时只做静态站点，不缓存）
VITE_ENABLE_SW=true

# 开发者模式默认开关（提示词预览 / 原始请求响应 / 日志流）
VITE_DEV_MODE=false
